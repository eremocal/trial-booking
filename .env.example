# Copy to .env at the repo root:  cp .env.example .env
# Every setting the stack reads lives here; nothing else hardcodes these values.

# Postgres. docker compose creates this user and both databases on first boot.
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
POSTGRES_DB=trial_class_booking
POSTGRES_TEST_DB=trial_class_booking_test

# Where the API, seed script and tests reach Postgres from your machine.
# 5434 rather than 5432, since machines often already run Postgres on 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# API
API_PORT=3001

# Web app. The browser calls this, so it must be reachable from your machine.
NEXT_PUBLIC_API_URL=http://localhost:3001
